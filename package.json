{
  "name": "gradingagent",
  "displayName": "Grading Agent",
  "description": "An extension to automate grading of programming assignments as much as possible",
  "version": "0.0.1",
  "publisher": "fmachadopiriz",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucudal/GradingAgent_VSCode_Extension.git"
  },
  "author": "Fernando Machado Píriz",
  "homepage": "https://github.com/ucudal/GradingAgent_VSCode_Extension",
  "license": "MIT",
  "keywords": [
    "grading agent",
    "grading",
    "copilot",
    "assignment",
    "education",
    "moodle"
  ],
  "icon": "icon.jpeg",
  "engines": {
    "vscode": "^1.108.1"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gradingagent.extractRepos",
        "title": "Grading Agent: Extract Students' Repositories"
      },
      {
        "command": "gradingagent.cloneRepos",
        "title": "Grading Agent: Clone Students' Repositories"
      },
      {
        "command": "gradingagent.deleteRepos",
        "title": "Grading Agent: Delete Cloned Students' Repositories"
      },
      {
        "command": "gradingagent.openGradingAgent",
        "title": "Grading Agent: Open Grading Agent"
      },
      {
        "command": "gradingagent.gradeSubmission",
        "title": "Grading Agent: Grade Submission"
      },
      {
        "command": "gradingagent.configureChatAutoApprove",
        "title": "Grading Agent: Configure Chat Auto Approve"
      },
      {
        "command": "gradingagent.deleteGrades",
        "title": "Grading Agent: Delete Grades"
      }
    ],
    "configuration": {
      "title": "Grading Agent",
      "properties": {
        "gradingagent.gradesFileName": {
          "type": "string",
          "default": "grades.csv",
          "description": "Name of the grades file stored in the workspace root"
        },
        "gradingagent.studentGradeFileName": {
          "type": "string",
          "default": "GRADE.md",
          "description": "Name of the grade file stored inside each student folder"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "sinon": "^21.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
