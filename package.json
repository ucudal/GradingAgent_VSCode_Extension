{
  "name": "gradingagent",
  "displayName": "GradingAgent",
  "description": "An extension to automate grading of programming assignments as much as possible",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [ ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gradingagent.extractRepos",
        "title": "Grading Agente: Extract Student's Repositories"
      },
      {
        "command": "gradingagent.cloneRepos",
        "title": "Grading Agent: Clone Student's Repositories"
      },
      {
        "command": "gradingagent.deleteRepos",
        "title": "Grading Agent: Delete Cloned Student's Repositories"
      },
      {
        "command": "gradingagnet.openGradingAgent",
        "title": "Grading Agent: Open GradingAgent"
      },
      {
        "command": "gradingagent.gradeSubmission",
        "title": "Grading Agent: Grade Submission"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
